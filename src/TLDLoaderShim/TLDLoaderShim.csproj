<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- TLDLoader mods reference an assembly named "TLDLoader": this stub is that assembly -->
    <AssemblyName>TLDLoader</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Unit callers pass a per-test obj/ subdirectory; never compile artifacts
         left in the normal obj/ directory by a developer build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**</DefaultItemExcludes>
      <!-- no build-machine paths in the DLL (the PDB path and source paths carry the user name) -->
    <PathMap>$(MSBuildProjectDirectory)=/src/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
  <!-- LoadAssets (meshes and textures, asset bundles, .png/.jpg) needs Unity: built in whenever lib/ has it (every real
       build and release). Without lib/ (CI's docs job builds the loader fixtures on a bare runner) the shim is built
       without LoadAssets, as before. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../../lib/UnityEngine.AssetBundleModule.dll')">
    <DefineConstants>$(DefineConstants);TLD_UNITY</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../lib/UnityEngine.AssetBundleModule.dll')">
    <Reference Include="$(MSBuildThisFileDirectory)../../lib/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(MSBuildThisFileDirectory)../../lib/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="$(MSBuildThisFileDirectory)../../lib/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(MSBuildThisFileDirectory)../../lib/UnityEngine.PhysicsModule.dll" Private="false" />
    <!-- SettingAPI (IMGUI), Keybind (Input), Events (the game's seatscript), UseHarmony (Harmony) -->
    <Reference Include="$(MSBuildThisFileDirectory)../../lib/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(MSBuildThisFileDirectory)../../lib/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(MSBuildThisFileDirectory)../../lib/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(MSBuildThisFileDirectory)../../lib/0Harmony.dll" Private="false" />
  </ItemGroup>
  <!-- a lib/ made before LoadAssets (no AssetBundleModule yet) would build a release without it, silently -->
  <Target Name="LibHasAssetBundles" BeforeTargets="CoreCompile"
          Condition="Exists('$(MSBuildThisFileDirectory)../../lib/UnityEngine.CoreModule.dll') And !Exists('$(MSBuildThisFileDirectory)../../lib/UnityEngine.AssetBundleModule.dll')">
    <Error Text="lib/ has no UnityEngine.AssetBundleModule.dll (TLDLoader's LoadAssets needs it): run tools/libs.sh again" />
  </Target>
</Project>
